<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>おすすめご飯</title>
  <%= stylesheet_link_tag 'meals', media: 'all' %>
</head>
<body>

  <div class = suggestion-title>あなたにおすすめのごはんは…</div>
  <div class="meal-suggestion" id="mealName">とんこつラーメン</div>
  <%# <img src="https://source.unsplash.com/600x400/?tonkotsu-ramen" alt="おすすめご飯の画像"> %>

  <button onclick="searchNearbyShops()">近くのお店を探す</button>

  <div id="results"></div>

  <script>
    // 仮の店データ（APIがまだない場合用）
    const shops = [
      { name: "一風堂 渋谷店", address: "東京都渋谷区神南1-3-13" },
      { name: "ラーメン花月 嵐", address: "東京都渋谷区道玄坂2-10-12" },
      { name: "博多天神", address: "東京都渋谷区宇田川町31-3" }
    ];

    function searchNearbyShops() {
      const container = document.getElementById("results");
      container.innerHTML = "<div Class = suggestion-title>おすすめ店舗:</div>";
      shops.forEach(shop => {
        const div = document.createElement("div");
        div.className = "shop";
        div.innerHTML = `<strong>${shop.name}</strong><br>${shop.address}`;
        container.appendChild(div);
      });

      // 将来的にはここでOpenAI + Web検索 or Google Maps APIなどでリアルタイム取得
    }
  </script>

</body>
</html>
